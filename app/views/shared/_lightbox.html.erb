<% content_for :head, javascript_include_tag("lightbox", defer: true) %>
<dialog id="lightbox" class="lightbox" aria-label="Fotografie">
  <% { close: "Zavřít", prev: "Předchozí fotka", next: "Další fotka" }.each do |action, label| %>
    <%= render "shared/icon_button", icon: action, label: label, data: { action: action },
                                      css_class: "icon-button--on-dark lightbox__button lightbox__button--#{action}" %>
  <% end %>
  <figure class="lightbox__stage">
    <img class="lightbox__image" alt="">
    <figcaption><span class="lightbox__caption"></span> <span class="lightbox__counter"></span></figcaption>
  </figure>
</dialog>
