<section class="contact-band">
  <div class="container contact-band__inner">
    <div>
      <h2>Potřebujete něco přivézt nebo odvézt?</h2>
      <p>Zavolejte nebo napište, domluvíme termín i cenu.</p>
    </div>
    <div class="button-row">
      <%= phone_link class: "button button--light button--large" %>
      <%= mail_to Company::EMAIL, class: "button button--ghost button--large" %>
    </div>
  </div>
</section>
