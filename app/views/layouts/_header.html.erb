<% brand_prefix, _, brand_name = company.name.rpartition(" ") %>
<header class="site-header">
  <div class="container site-header__inner">
    <%= link_to page_url(:home), class: "brand", aria: { label: "#{company.name} – úvod" } do %>
      <%= render "shared/brand_mark" %>
      <span class="brand__text">
        <span class="brand__small"><%= brand_prefix %></span>
        <span class="brand__name"><%= brand_name %></span>
      </span>
    <% end %>

    <nav class="site-nav" aria-label="Hlavní menu">
      <%= nav_links SitePage.navigation %>
    </nav>

    <%= phone_link class: "button button--primary site-header__cta" %>

    <%= link_to company.phone_uri, class: "icon-button site-header__call", aria: { label: "Zavolat #{company.phone}" } do %>
      <%= render "shared/icon", name: :phone %>
    <% end %>

    <details class="mobile-nav" data-mobile-nav>
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <nav class="mobile-nav__panel" aria-label="Mobilní menu">
        <%= nav_links SitePage.navigation %>
        <%= phone_link "Zavolat #{company.phone}", class: "button button--primary" %>
      </nav>
    </details>
  </div>
</header>
