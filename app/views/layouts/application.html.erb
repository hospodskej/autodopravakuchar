<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= render "layouts/meta" %>
    <meta name="theme-color" content="#1f4d2b">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Preload the two most used fonts so text does not shift when they arrive. %>
    <% %w[barlow-400.woff2 barlow-condensed-700.woff2].each do |font| %>
      <link rel="preload" href="<%= font_path(font) %>" as="font" type="font/woff2" crossorigin>
    <% end %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_include_tag "menu", defer: true %>
  </head>

  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <%= render "layouts/header" %>

    <main id="obsah">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
