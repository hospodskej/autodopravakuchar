<%= page_header "Technika a vybavení", "Nákladní vozy MAN a Avia, kontejnery a minibagr. Kliknutím fotku zvětšíte." %>

<section class="section">
  <div class="container gallery">
    <% @photos.each do |photo| %>
      <%= link_to image_path(photo.path), class: "gallery__item", target: "_blank", rel: "noopener" do %>
        <%= gallery_thumbnail photo %>
      <% end %>
    <% end %>
  </div>
</section>

<%= render "shared/contact_band" %>
