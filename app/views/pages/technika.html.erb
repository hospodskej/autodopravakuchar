<%= render "shared/page_header" %>

<section class="section section--compact">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Vozový park</p>
      <h2>Čím jezdíme</h2>
    </div>
    <ul class="card-grid">
      <% FleetVehicle.all.each do |vehicle| %>
        <li class="card card--accent fleet-card">
          <h3><%= vehicle.name %></h3>
          <p class="muted"><%= vehicle.detail %></p>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<nav class="chip-nav container" aria-label="Kategorie techniky">
  <% GalleryCategory.all.each do |category| %>
    <%= link_to "#{category.title} (#{category.photos.size})", "##{category.key}", class: "chip" %>
  <% end %>
</nav>

<% GalleryCategory.all.each do |category| %>
  <section class="section section--compact" id="<%= category.key %>">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><%= pluralize(category.photos.size, "fotka", plural: category.photos.size < 5 ? "fotky" : "fotek") %></p>
        <h2><%= category.title %></h2>
        <p class="muted"><%= category.description %></p>
      </div>
      <%= render "shared/photo_grid", photos: category.photos, lightbox: true %>
    </div>
  </section>
<% end %>

<%= render "shared/lightbox" %>
<%= render "shared/contact_band" %>
