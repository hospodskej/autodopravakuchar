<%= render "shared/page_header" %>

<section class="section">
  <div class="container container--narrow">
    <%= render "shared/flash" %>

    <% if @inquiry.errors.any? %>
      <div class="flash flash--error" role="alert">
        <p><strong>Formulář obsahuje chyby:</strong></p>
        <ul><% @inquiry.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
      </div>
    <% end %>

    <%= form_with model: @inquiry, url: inquiries_path, scope: :inquiry, class: "card card--accent inquiry-form", data: { turbo: false } do |form| %>
      <div class="form-grid">
        <%= form_field form, :name, label: "Jméno a příjmení", required: true, autocomplete: "name", maxlength: 100 %>
        <%= form_field form, :phone, label: "Telefon", input: :telephone_field, required: true, autocomplete: "tel", inputmode: "tel",
                                     hint: "Ozveme se vám na něj s nabídkou." %>
        <%= form_field form, :email, label: "E-mail", input: :email_field, autocomplete: "email", hint: "Nepovinný." %>
        <%= form_field form, :service, label: "Co potřebujete", input: :select, required: true, choices: Inquiry.services %>
        <%= form_field form, :place, label: "Kam (obec, adresa)", required: true, autocomplete: "address-level2", maxlength: 200 %>
        <%= form_field form, :date, label: "Kdy", hint: "Např. „příští týden“ nebo konkrétní datum. Nepovinné.", maxlength: 50 %>
      </div>
      <%= form_field form, :message, label: "Podrobnosti", input: :text_area, required: true, rows: 5, maxlength: 3000,
                                     hint: "Druh a množství materiálu, velikost kontejneru, přístup na místo…" %>

      <div class="field--trap" aria-hidden="true">
        <%= form.label :website, "Nevyplňujte" %>
        <%= form.text_field :website, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= form.hidden_field :started_at, value: Inquiry.signed_start_time %>

      <p class="muted form-note">
        Údaje použijeme jen k vyřízení vaší poptávky, viz <%= link_to "zásady ochrany osobních údajů", page_url(:soukromi) %>.
        Pole označená <span class="field__required">*</span> jsou povinná.
      </p>
      <div class="button-row">
        <%= form.submit "Odeslat poptávku", class: "button button--primary button--large" %>
        <%= phone_link "Raději zavolat", class: "button button--secondary button--large" %>
      </div>
    <% end %>
  </div>
</section>
