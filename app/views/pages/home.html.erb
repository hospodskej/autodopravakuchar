<section class="hero">
  <%= photo_tag GalleryPhoto.find_by!(file: "foto-10.webp"), full: true, alt: "", class: "hero__image", loading: "eager", fetchpriority: "high" %>
  <div class="container">
    <p class="eyebrow eyebrow--light"><%= company.city %> · <%= company.region %></p>
    <h1 class="hero__title">Dovezeme, odvezeme,<br>vybagrujeme.</h1>
    <p class="lead hero__lead">
      Písek, štěrk, beton i veškerý stavební materiál. Kontejnery na suť a zeminu,
      přeprava techniky do 6 t a práce bagrem – rychle, kvalitně a za férové ceny.
    </p>
    <div class="button-row">
      <%= phone_link "Zavolat #{company.phone}", class: "button button--primary button--large" %>
      <%= link_to "Naše služby", page_url(:sluzby), class: "button button--ghost button--large" %>
    </div>
  </div>
</section>

<div class="hazard-stripe" aria-hidden="true"></div>

<section class="section">
  <div class="container">
    <%= render "shared/section_heading", eyebrow: "Co děláme", title: "Služby pro stavbu, dům i zahradu",
                                         link: { label: "Všechny služby", url: page_url(:sluzby) } %>
    <ol class="card-grid">
      <%= render partial: "services/card", collection: Service.all %>
    </ol>
  </div>
</section>

<section class="section section--tinted">
  <div class="container split">
    <%= photo_tag GalleryPhoto.find_by!(file: "foto-06.webp"), class: "media-cover split__image" %>
    <div>
      <p class="eyebrow">Vlastní technika</p>
      <h2>Nákladní vozy, kontejnery a minibagr</h2>
      <p class="muted">
        Jezdíme vlastními vozy MAN s kontejnery, do těžkého terénu máme Pragu V3S a k tomu vlastní bagr.
        Materiál přivezeme, výkop uděláme a zeminu rovnou odvezeme – všechno od jednoho dodavatele.
      </p>
      <%= link_to "Prohlédnout techniku", page_url(:technika), class: "button button--secondary" %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <%= render "shared/section_heading", eyebrow: "Z naší práce", title: "Fotky z akcí",
                                         link: { label: "Celá galerie", url: page_url(:technika) } %>
    <%= render "shared/photo_grid", photos: GalleryPhoto.featured, css_class: "photo-grid photo-grid--strip" %>
  </div>
</section>

<%= render "shared/contact_band" %>
