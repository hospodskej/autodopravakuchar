<%= render "shared/page_header" %>

<%
  channels = [
    { label: "Telefon", value: company.phone, url: company.phone_uri, action: "Zavolat" },
    { label: "E-mail", value: company.email, url: company.email_uri, action: "Napsat" },
    { label: "Adresa", value: company.address_lines.join(", "), meta: company.district, url: company.map_url,
      action: "Otevřít v mapě", external: true },
    { label: "Facebook", value: company.name, url: company.facebook, action: "Sledovat", external: true }
  ]
%>

<section class="section">
  <div class="container">
    <div class="card-grid">
      <% channels.each do |channel| %>
        <%= link_to channel[:url], class: "card card--interactive contact-card",
                    **(channel[:external] ? { target: "_blank", rel: "noopener" } : {}) do %>
          <span class="label"><%= channel[:label] %></span>
          <span class="contact-card__value"><%= channel[:value] %></span>
          <% if channel[:meta] %><span class="muted"><%= channel[:meta] %></span><% end %>
          <span class="contact-card__action"><%= channel[:action] %> →</span>
        <% end %>
      <% end %>
    </div>

    <h2 class="label legal-heading">Provozovatel</h2>
    <%= render "shared/legal_info" %>
  </div>
</section>
