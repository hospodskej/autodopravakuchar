<%= render "shared/page_header" %>

<section class="section">
  <div class="container container--narrow">
    <% if @price_groups.any? %>
      <% @price_groups.each do |category, items| %>
        <%= render "price_items/group", category:, items: %>
      <% end %>
      <p class="muted">Ceny jsou orientační. Pro přesnou nabídku nás <%= link_to "kontaktujte", page_url(:kontakty) %>.</p>
    <% else %>
      <div class="card card--accent empty-state">
        <h2>Ceník připravujeme</h2>
        <p class="muted">Pro cenovou nabídku nás prosím kontaktujte – ozveme se co nejdříve.</p>
        <%= render "shared/contact_buttons" %>
      </div>
    <% end %>
  </div>
</section>
